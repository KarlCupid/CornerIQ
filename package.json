{
  "name": "corneriq",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run test",
    "qa:web": "node scripts/start-agent-web.mjs",
    "qa:web:update": "node scripts/run-agent-browser-audit.mjs --update-snapshots",
    "qa:agent:audit": "node scripts/run-agent-browser-audit.mjs",
    "qa:agent:report": "node scripts/create-agent-qa-report.mjs",
    "qa:engine:review": "node scripts/create-engine-output-review.mjs",
    "qa:agent:analyze": "node scripts/analyze-agent-qa-evidence.mjs",
    "qa:agent:contact-sheet": "node scripts/create-agent-qa-contact-sheet.mjs",
    "qa:agent:bundle": "node scripts/create-agent-qa-bundle.mjs",
    "qa:agent:ci": "node scripts/run-agent-qa-ci.mjs",
    "qa:loop:state": "node scripts/print-qa-loop-state.mjs",
    "preflight:beta": "node scripts/beta-preflight.mjs",
    "smoke:live-db": "vitest run src/tests/live/liveDbSmoke.test.ts"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react-native": "13.2.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.0",
    "react-test-renderer": "19.1.0",
    "supabase": "2.100.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.1.0"
  }
}
