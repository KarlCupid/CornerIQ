{
  "name": "corneriq",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run test",
    "smoke:fixtures": "vitest run src/tests/beta/betaScenarioFlows.test.ts src/tests/engine/performanceKernel.test.ts",
    "qa:web": "node scripts/start-agent-web.mjs",
    "qa:web:update": "node scripts/run-agent-browser-audit.mjs --update-snapshots",
    "qa:agent:audit": "node scripts/run-agent-browser-audit.mjs",
    "qa:agent:report": "node scripts/create-agent-qa-report.mjs",
    "qa:engine:review": "node scripts/create-engine-output-review.mjs",
    "qa:agent:analyze": "node scripts/analyze-agent-qa-evidence.mjs",
    "qa:agent:contact-sheet": "node scripts/create-agent-qa-contact-sheet.mjs",
    "qa:agent:bundle": "node scripts/create-agent-qa-bundle.mjs",
    "qa:agent:ci": "node scripts/run-agent-qa-ci.mjs --all",
    "qa:loop:state": "node scripts/print-qa-loop-state.mjs",
    "ci:static": "node scripts/run-agent-qa-ci.mjs --gate ci:static",
    "ci:typecheck": "node scripts/run-agent-qa-ci.mjs --gate ci:typecheck",
    "ci:unit": "node scripts/run-agent-qa-ci.mjs --gate ci:unit",
    "ci:lint": "node scripts/run-agent-qa-ci.mjs --gate ci:lint",
    "ci:preflight": "node scripts/run-agent-qa-ci.mjs --gate ci:preflight",
    "ci:agent-browser": "node scripts/run-agent-qa-ci.mjs --gate ci:agent-browser",
    "ci:engine-output-review": "node scripts/run-agent-qa-ci.mjs --gate ci:engine-output-review",
    "ci:agent-bundle": "node scripts/run-agent-qa-ci.mjs --gate ci:agent-bundle",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:quality": "node scripts/release-quality-gate.mjs",
    "cleanup:training-derived-state": "node scripts/cleanup-regeneration-derived-state.mjs",
    "dev:reset:supabase": "node scripts/dev-reset-supabase.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "preflight:beta": "npm run preflight:production",
    "smoke:live-db": "vitest run src/tests/live/liveDbSmoke.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
